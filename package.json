{
  "name": "x3lanix-launcher",
  "version": "1.0.0",
  "description": "x3lanix client — Premium Custom Minecraft Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win dir"
  },
  "author": "X3LANIX",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.7.9",
    "electron-store": "8.1.0",
    "minecraft-launcher-core": "^3.18.1",
    "msmc": "^5.0.5",
    "sharp": "^0.35.4",
    "skinview3d": "^3.4.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.x3lanix.launcher",
    "productName": "x3lanix client",
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "x3lanix client.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "backend/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist2"
    }
  }
}
